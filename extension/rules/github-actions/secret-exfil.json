{
  "id": "gha-secret-exfiltration",
  "name": "GitHub Actions Secret Exfiltration",
  "description": "Detects attempts to exfiltrate secrets from GitHub Actions workflows",
  "severity": "critical",
  "confidence": "high",
  "category": "github-actions",
  "tags": ["ci-cd", "credential-theft", "exfiltration", "github-actions"],
  "references": [
    "https://blog.gitguardian.com/github-actions-security-cheat-sheet/"
  ],
  "mitre": {
    "tactic": "Exfiltration",
    "technique": "T1041"
  },
  "matchers": [
    {
      "id": "m1",
      "type": "regex",
      "pattern": "(curl|wget|nc|ncat)\\s+.*\\$\\{\\{\\s*secrets\\.",
      "description": "Sending secrets to external endpoint"
    },
    {
      "id": "m2",
      "type": "regex",
      "pattern": "echo\\s+.*\\$\\{\\{\\s*secrets\\..*\\}\\}.*>",
      "description": "Writing secrets to file"
    },
    {
      "id": "m3",
      "type": "regex",
      "pattern": "base64.*\\$\\{\\{\\s*secrets\\.",
      "description": "Base64 encoding secrets"
    },
    {
      "id": "m4",
      "type": "regex",
      "pattern": "\\$\\{\\{\\s*secrets\\.[^}]+\\}\\}.*ngrok|hookbin|requestbin|webhook\\.site|pipedream",
      "description": "Secrets sent to known exfil services"
    },
    {
      "id": "m5",
      "type": "string-any",
      "patterns": [
        "printenv | curl",
        "env | curl",
        "set | curl",
        "printenv | nc",
        "env | wget"
      ],
      "description": "Dumping environment to external endpoint"
    }
  ],
  "condition": {
    "type": "any",
    "of": ["m1", "m2", "m3", "m4", "m5"]
  },
  "appliesTo": {
    "filePatterns": ["**/.github/workflows/*.yml", "**/.github/workflows/*.yaml"]
  }
}

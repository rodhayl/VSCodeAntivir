{
  "id": "credential-harvesting",
  "name": "Credential and Secret Harvesting",
  "version": "1.0.0",
  "severity": "high",
  "confidence": "medium",
  "description": "Detects scripts that enumerate and harvest credentials, wallet data, password stores, and cryptographic keys",
  "category": "credential-access",
  "campaign": "contagious-interview",
  "mitre": {
    "tactic": "Credential Access",
    "technique": "T1555",
    "name": "Credentials from Password Stores"
  },
  "appliesTo": {
    "languages": ["javascript", "python", "powershell", "shellscript"],
    "filePatterns": ["**/*.js", "**/*.py", "**/*.ps1", "**/*.sh"]
  },
  "matchers": [
    { "id": "wallet-keywords", "type": "string-any", "patterns": ["wallet", "mnemonic", "seed_phrase", "keystore", "private_key", "recovery"], "caseSensitive": false },
    { "id": "password-stores", "type": "string-any", "patterns": ["KeePass", ".kdbx", "1Password", "LastPass", "Bitwarden"], "caseSensitive": false },
    { "id": "env-files", "type": "regex", "pattern": "\\.env|dotenv|process\\.env" },
    { "id": "recursive-scan", "type": "regex", "pattern": "readdirSync|walkDir|scanDir|os\\.walk|find\\s+/" },
    { "id": "http-post-exfil", "type": "regex", "pattern": "POST|axios\\.post|requests\\.post|fetch.*method.*POST" }
  ],
  "condition": { "type": "threshold", "minimum": 3, "of": ["wallet-keywords", "password-stores", "env-files", "recursive-scan", "http-post-exfil"] },
  "remediation": {
    "message": "This file contains credential harvesting patterns. Review immediately.",
    "actions": ["quarantine"]
  }
}

{
  "id": "npm-supply-chain",
  "name": "Suspicious npm Package Configuration",
  "version": "1.0.0",
  "severity": "high",
  "confidence": "medium",
  "description": "Detects npm packages with suspicious install scripts, encoded payloads, or typosquatting indicators typical of supply-chain attacks",
  "category": "initial-access",
  "campaign": "contagious-interview",
  "mitre": {
    "tactic": "Initial Access",
    "technique": "T1195.002",
    "name": "Supply Chain Compromise: Compromise Software Supply Chain"
  },
  "appliesTo": {
    "languages": ["json"],
    "filePatterns": ["**/package.json"]
  },
  "matchers": [
    { "id": "preinstall", "type": "string", "pattern": "preinstall" },
    { "id": "postinstall", "type": "string", "pattern": "postinstall" },
    { "id": "node-exec", "type": "regex", "pattern": "node\\s+\\w+\\.js" },
    { "id": "curl-wget", "type": "regex", "pattern": "curl\\s|wget\\s" },
    { "id": "suspicious-name", "type": "string-any", "patterns": ["setup_bun", "bun_environment", "install.js", "setup_node"] }
  ],
  "condition": { "type": "threshold", "minimum": 2, "of": ["preinstall", "postinstall", "node-exec", "curl-wget", "suspicious-name"] },
  "remediation": {
    "message": "This package.json has suspicious install scripts typical of supply-chain attacks.",
    "actions": ["remove-hook"]
  }
}

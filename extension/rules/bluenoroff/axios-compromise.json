{
  "id": "bn-axios-compromise",
  "name": "Axios Supply Chain Attack (March 2026)",
  "version": "1.0.0",
  "severity": "critical",
  "confidence": "high",
  "description": "Detects indicators from the March 2026 Axios npm supply chain attack attributed to BlueNoroff/UNC1069",
  "category": "supply-chain",
  "campaign": "bluenoroff-axios-2026",
  "mitre": {
    "tactic": "Initial Access",
    "technique": "T1195.002",
    "name": "Compromise Software Supply Chain"
  },
  "appliesTo": {
    "languages": ["javascript", "typescript", "json"],

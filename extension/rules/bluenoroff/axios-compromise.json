    { "id": "axios-malicious-ver2", "type": "regex", "pattern": "\"axios\"\\s*:\\s*\"0\\.30\\.4\"" },
    { "id": "c2-domain", "type": "string", "pattern": "sfrclak.com" },
    { "id": "setup-js-dropper", "type": "regex", "pattern": "setup\\.js.*postinstall" },
    { "id": "wt-exe-copy", "type": "regex", "pattern": "%PROGRAMDATA%.*wt\\.exe|PROGRAMDATA.*wt\\.exe" }
  ],
  "condition": { "type": "any", "of": ["plain-crypto-js", "axios-malicious-ver1", "axios-malicious-ver2", "c2-domain"] },
  "remediation": {
    "message": "This code references known IOCs from the Axios supply chain attack (March 2026). Immediately: 1) Remove affected packages, 2) Rotate all credentials, 3) Check for persistence mechanisms.",
    "actions": ["quarantine", "review"]
  }
}

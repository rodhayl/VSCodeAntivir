{
  "name": "fake-interview-guard",
  "displayName": "FakeInterviewGuard",
  "description": "Detect Contagious Interview malware patterns in your workspace — npm supply-chain attacks, VS Code task abuse, backdoor signatures, and more.",
  "version": "1.0.0",
  "publisher": "fakeinterviewguard",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/rulf-ra/VSCodeAntivir"
  },
  "bugs": {
    "url": "https://github.com/rulf-ra/VSCodeAntivir/issues"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "keywords": [
    "security",
    "malware",
    "npm",
    "supply-chain",
    "contagious-interview"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:fig.scanWorkspace",
    "onCommand:fig.scanFile",
    "onCommand:fig.showDashboard",
    "onCommand:fig.showQuarantine",
    "onCommand:fig.quarantineFile",
    "onCommand:fig.reloadRules",
    "onCommand:fig.llmAnalyze",
    "onCommand:fig.llmExplain",
    "onCommand:fig.llmSuggestRule",
    "onCommand:fig.llmStatus"
  ],
  "contributes": {
    "commands": [
      {
        "command": "fig.scanWorkspace",
        "title": "FIG: Scan Entire Workspace",
        "icon": "$(search)"
      },
      {
        "command": "fig.scanFile",
        "title": "FIG: Scan Current File",
        "icon": "$(file-code)"
      },
      {
        "command": "fig.showDashboard",
        "title": "FIG: Show Security Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "fig.showQuarantine",
        "title": "FIG: Show Quarantine Manager",
        "icon": "$(trash)"
      },
      {
        "command": "fig.quarantineFile",
        "title": "FIG: Quarantine Current File",
        "icon": "$(archive)"
      },
      {
        "command": "fig.reloadRules",
        "title": "FIG: Reload Detection Rules",
        "icon": "$(refresh)"
      },
      {
        "command": "fig.llmAnalyze",
        "title": "FIG: Deep Analyze with LLM",
        "icon": "$(hubot)"
      },
      {
        "command": "fig.llmExplain",
        "title": "FIG: Explain This Threat (LLM)"
      },
      {
        "command": "fig.llmSuggestRule",
        "title": "FIG: Suggest Detection Rule (LLM)"
      },
      {
        "command": "fig.llmStatus",
        "title": "FIG: Check LLM Connection"
      }
    ],
    "views": {
      "fig-security": [
        {
          "id": "fig.threatExplorer",
          "name": "Threat Explorer"
        },
        {
          "id": "fig.quarantine",
          "name": "Quarantine"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "fig-security",
          "title": "FakeInterviewGuard",
          "icon": "$(shield)"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "fig.scanFile",
          "group": "fig@1",
          "when": "resourceScheme == file"
        },
        {
          "command": "fig.quarantineFile",
          "group": "fig@2",
          "when": "resourceScheme == file"
        }
      ],
      "editor/context": [
        {
          "command": "fig.scanFile",
          "group": "fig@1"
        },
        {
          "command": "fig.quarantineFile",
          "group": "fig@2"
        }
      ]
    },
    "configuration": {
      "title": "FakeInterviewGuard",
      "properties": {
        "fig.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Scan files automatically when saved"
        },
        "fig.scanOnOpen": {
          "type": "boolean",
          "default": true,
          "description": "Scan files when opened in the editor"
        },
        "fig.realTimeWatching": {
          "type": "boolean",
          "default": true,
          "description": "Monitor workspace for new/modified files"
        },
        "fig.minimumSeverity": {
          "type": "string",
          "default": "low",
          "enum": [
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ],
          "description": "Minimum severity to report"
        },
        "fig.excludedPaths": {
          "type": "array",
          "default": [
            "**/node_modules/**",
            "**/.git/**"
          ],
          "description": "Glob patterns to exclude from scanning"
        },
        "fig.customRulesPath": {
          "type": "string",
          "default": "",
          "description": "Path to directory containing custom rule JSON files"
        },
        "fig.enabledRuleSets": {
          "type": "array",
          "default": [
            "contagious-interview",
            "general",
            "supply-chain",
            "credential-harvesting",
            "persistence",
            "bluenoroff",
            "teampcp",
            "github-actions",
            "silver-fox",
            "russian-apt",
            "ide-extensions",
            "ai-tooling",
            "stealth"
          ],
          "description": "Which built-in rule sets to enable"
        },
        "fig.maxFileSizeKB": {
          "type": "number",
          "default": 512,
          "description": "Skip files larger than this (KB)"
        },
        "fig.llm.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable LLM-powered deep analysis (requires LM Studio, Ollama, or compatible provider)"
        },
        "fig.llm.provider": {
          "type": "string",
          "default": "lmstudio",
          "enum": [
            "lmstudio",
            "ollama",
            "openai",
            "custom"
          ],
          "description": "LLM provider to use"
        },
        "fig.llm.baseUrl": {
          "type": "string",
          "default": "",
          "description": "Custom API base URL (leave empty to use provider default)"
        },
        "fig.llm.model": {
          "type": "string",
          "default": "qwen3.5-4b",
          "description": "Model name to use for analysis"
        },
        "fig.llm.apiKey": {
          "type": "string",
          "default": "",
          "description": "API key (leave empty for local providers)"
        },
        "fig.llm.maxTokens": {
          "type": "number",
          "default": 1024,
          "description": "Maximum tokens in LLM response"
        },
        "fig.llm.temperature": {
          "type": "number",
          "default": 0.1,
          "description": "LLM temperature (0.0-1.0, lower = more deterministic)"
        },
        "fig.llm.autoAnalyze": {
          "type": "boolean",
          "default": false,
          "description": "Automatically run LLM analysis when fast scan finds high-severity threats"
        },
        "fig.llm.timeout": {
          "type": "number",
          "default": 60000,
          "description": "LLM request timeout in milliseconds"
        },
        "fig.llm.promptProfile": {
          "type": "string",
          "default": "Security Analysis",
          "description": "Prompt template name to use for analysis"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\"",
    "vscode:prepublish": "npm run compile",
    "compile": "npm run clean && tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint \"src/**/*.ts\"",
    "test:unit": "npm run compile && node ./test/runUnit.js",
    "test:integration": "npm run compile && node ./test/runTest.js",
    "test": "npm run test:unit && npm run test:integration",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.0",
    "@types/node": "^26.1.1",
    "@types/vscode": "^1.125.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.8.0",
    "mocha": "^11.7.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.0",
    "minimatch": "^10.2.5",
    "openai": "^6.46.0"
  }
}
